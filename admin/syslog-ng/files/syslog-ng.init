#!/bin/sh /etc/rc.common
# Copyright (C) 2006-2019 OpenWrt.org
# syslog-ng init script — UCI-driven configuration via syslog-ng-config

START=50

USE_PROCD=1

SYSLOG_CONF="/etc/syslog-ng.conf"
SYSLOG_CONFIG_BIN="/usr/sbin/syslog-ng-config"

start_service() {
	# Generate syslog-ng.conf and logrotate config from UCI before starting
	if [ -x "$SYSLOG_CONFIG_BIN" ]; then
		echo "$(date '+%b %d %H:%M:%S') Generating syslog-ng configuration from UCI..."
		"$SYSLOG_CONFIG_BIN" generate
	fi

	[ -f "$SYSLOG_CONF" ] || {
		echo "$(date '+%b %d %H:%M:%S') ERROR: $SYSLOG_CONF not found — cannot start syslog-ng" >&2
		return 1
	}

	# Disable the default logd/logread daemon
	/etc/init.d/log stop 2>/dev/null
	/etc/init.d/log disable 2>/dev/null

	procd_open_instance
	procd_set_param command /usr/sbin/syslog-ng --foreground
	procd_set_param respawn
	procd_close_instance

	echo "$(date '+%b %d %H:%M:%S') syslog-ng started."
}

reload_service() {
	# Regenerate configs from UCI and reload syslog-ng without restart
	if [ -x "$SYSLOG_CONFIG_BIN" ]; then
		echo "$(date '+%b %d %H:%M:%S') Applying syslog-ng configuration from UCI..."
		"$SYSLOG_CONFIG_BIN" apply && \
			echo "$(date '+%b %d %H:%M:%S') syslog-ng configuration reloaded."
	else
		# Fallback: direct reload if config script not available
		/usr/sbin/syslog-ng-ctl reload && \
			echo "$(date '+%b %d %H:%M:%S') syslog-ng configuration reloaded."
	fi
}

stop_service() {
	echo "$(date '+%b %d %H:%M:%S') syslog-ng stopped."
	# Re-enable the default log daemon so the system is not left without logging
	/etc/init.d/log enable 2>/dev/null
	/etc/init.d/log start 2>/dev/null
}
