--- openvswitch-2.11.1.old/datapath/linux/compat/include/linux/openvswitch.h	2020-07-01 10:21:26.678791554 +0530
+++ openvswitch-2.11.1.new/datapath/linux/compat/include/linux/openvswitch.h	2020-07-01 10:27:25.979701640 +0530
@@ -288,6 +288,7 @@
 	OVS_VPORT_ATTR_PAD,
 	OVS_VPORT_ATTR_IFINDEX,
 	OVS_VPORT_ATTR_NETNSID,
+	OVS_VPORT_ATTR_MASTER,	/* string name, up to IFNAMSIZ bytes long */
 	__OVS_VPORT_ATTR_MAX
